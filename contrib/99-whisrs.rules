# Grant members of the "input" group access to /dev/uinput, which whisrs needs
# in order to synthesize keystrokes.
#
# MODE/GROUP alone are not enough if another udev rule (e.g. brltty) sets an
# ACL on /dev/uinput, because ACLs override traditional Unix group permissions.
# The setfacl call below ensures the input group always has read-write access
# regardless of ACL state.
#
# Packagers: the rule below uses the FHS setfacl path. On distributions that put
# it elsewhere (NixOS, Guix), rewrite both occurrences at build time — the TEST==
# guard makes this rule a silent no-op when the path does not exist.
#
# static_node=uinput also applies MODE/GROUP/TAG to the /dev/uinput node that
# exists at boot before the uinput module is loaded. Without it that node stays
# root:root 0600, and since the module only autoloads when the node is opened,
# a non-root open is refused and the module never loads, so the rule never fires.
#
# Installation instructions live in README.md and docs/troubleshooting.md.
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", TAG+="uaccess", OPTIONS+="static_node=uinput"
KERNEL=="uinput", SUBSYSTEM=="misc", TEST=="/usr/bin/setfacl", RUN+="/usr/bin/setfacl -m g:input:rw /dev/$name"
